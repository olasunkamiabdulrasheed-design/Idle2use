# Copy this file to .env and fill in real values. Never commit .env.
# Stage 1: only DJANGO_* / CORS variables are needed locally.
# The POSTGRES_* variables are required once a PostgreSQL server is available.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL (leave unset to use local SQLite for development)
POSTGRES_DB=idle2use
POSTGRES_USER=idle2use
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
