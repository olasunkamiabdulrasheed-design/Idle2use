# Copy this file to .env and fill in real values. Never commit .env.
# Both naming conventions work: DJANGO_SECRET_KEY and SECRET_KEY, etc.
# (render.yaml provides these automatically — see render.yaml.)

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Legacy aliases (also read):
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

# HTTPS origins allowed to POST through Django's CSRF middleware (comma-separated)
CSRF_TRUSTED_ORIGINS=

# Database — Render supplies DATABASE_URL automatically.
# Leave unset (and POSTGRES_* unset) to use local SQLite development.
DATABASE_URL=
# POSTGRES_* alternative (leave unset to use local SQLite):
# POSTGRES_DB=idle2use
# POSTGRES_USER=idle2use
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# AI parser (backend-only — never exposed to the frontend)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional production toggles (defaults shown are Render-appropriate)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=0
